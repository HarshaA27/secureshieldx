# SecureShield X - LLM API Configuration Template
# Copy this file to '.env' in your project root or pass via --dart-define

# 1. API Key for your LLM provider (Google Gemini or OpenAI)
LLM_API_KEY=your_llm_api_key_here

# 2. LLM Provider: 'gemini' or 'openai' (Default: 'gemini')
LLM_API_PROVIDER=gemini

# 3. Model Name:
# For Gemini: 'gemini-1.5-flash' or 'gemini-1.5-pro'
# For OpenAI: 'gpt-4o-mini' or 'gpt-4o' or 'gpt-3.5-turbo'
LLM_MODEL=gemini-1.5-flash

# Optional Custom Endpoint (e.g. for self-hosted or proxy)
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
